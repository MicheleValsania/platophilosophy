<style>
    .reading p{margin:14px 0}
    .kicker{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;border:1px solid rgba(216,193,138,.18);background:rgba(216,193,138,.08);color:var(--text);font-size:13px;}
    .kdot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(216,193,138,.12);display:inline-block;}
    .toc{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 8px;}
    .toc a{padding:8px 14px;border:1px solid var(--stroke);border-radius:999px;color:var(--text);font-size:14px;}
    .section-title{margin-top:40px;padding-bottom:10px;border-bottom:2px solid var(--stroke);}
    .section-note{color:var(--muted);max-width:78ch;}
    .filter{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:16px 0 8px;}
    .filter-label{color:var(--muted);font-size:14px;}
    .chip{font:inherit;font-size:13px;padding:6px 12px;border-radius:999px;border:1px solid var(--stroke);background:transparent;color:var(--text);cursor:pointer;}
    .chip[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);}
    .chip:focus-visible,.toc a:focus-visible,.card-links a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
    .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin:16px 0;}
    .card{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-md);padding:16px;}
    .card[hidden]{display:none;}
    .card h3{margin:0;font-size:1.1rem;}
    .card-group{margin:4px 0 0;font-size:12px;color:var(--muted-soft);text-transform:uppercase;letter-spacing:.04em;}
    .card-text{color:var(--muted);font-size:14px;line-height:1.55;margin:10px 0;}
    .card-meta{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:13px;color:var(--muted-soft);margin:0;}
    .card-links{display:flex;flex-direction:column;gap:6px;margin:12px 0 0;font-size:13px;}
    .card-links a{color:var(--accent);}
    .tetralogy{margin-top:28px;font-size:1.15rem;}
    .works{list-style:none;padding:0;margin:8px 0;}
    .work{padding:12px 0;border-bottom:1px solid var(--stroke);}
    .work-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px;}
    .work-title{font-weight:700;color:var(--text);}
    .work-text{color:var(--muted);font-size:14px;line-height:1.55;margin:4px 0 0;}
    .items{list-style:none;margin:10px 0 0;padding-left:16px;border-left:2px solid var(--stroke);}
    .items li{padding:6px 0;}
    .attr{font-size:12px;padding:2px 8px;border-radius:999px;border:1px solid var(--stroke);color:var(--muted);white-space:nowrap;}
    .attr-generally-authentic{border-color:var(--accent);color:var(--text);}
    .attr-disputed{border-style:dashed;}
    .attr-generally-spurious{opacity:.85;}
    .in-sel{font-size:12px;color:var(--accent);}
    .muted{color:var(--muted-soft);}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;}
    .hr{height:1px;background:var(--stroke);margin:24px 0;}
    .nav-row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:32px;}
    @media (max-width:900px){.nav-row{flex-direction:column;}}
  </style>
