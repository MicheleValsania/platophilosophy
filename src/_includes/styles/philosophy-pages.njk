<style>.kicker{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;border:1px solid rgba(216,193,138,.18);background:rgba(216,193,138,.08);color:var(--text);font-size:13px}.kdot{width:7px;height:7px;border-radius:999px;background:var(--accent);box-shadow:0 0 0 4px rgba(216,193,138,.12)}.panel{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:16px;margin-top:18px}.meta-line{margin-top:10px;font-size:13px;color:var(--muted-soft)}.reading{max-width:78ch;line-height:1.7;color:var(--text)}.reading p{margin:14px 0}.reading h2{font-family:var(--font-serif);font-size:24px;color:var(--text-strong);margin:28px 0 14px}.reading blockquote{margin:20px 0;padding:16px 20px;border-left:3px solid var(--accent);background:rgba(216,193,138,.06);font-style:italic;color:var(--text)}.concept-box{background:rgba(216,193,138,.08);border:1px solid rgba(216,193,138,.20);border-radius:var(--radius-md);padding:14px;margin:18px 0}.concept-title{font-family:var(--font-serif);font-size:16px;color:var(--text-strong);margin:0 0 8px}.concept-text{font-size:14px;color:var(--muted);line-height:1.6}.list{margin:10px 0;padding-left:22px;color:var(--text);line-height:1.7}.list li{margin:8px 0}.hr{height:1px;background:var(--stroke);margin:24px 0}.nav-row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:18px}.mini{font-size:12px;color:var(--muted-soft)}.greek-term{font-style:italic;color:var(--accent)}.reading h3{font-family:var(--font-serif);font-size:19px;color:var(--text);margin:22px 0 10px}.reading ul,.reading ol{margin:12px 0;padding-left:24px;line-height:1.7}.reading li{margin:6px 0}.reading a{color:var(--accent);text-underline-offset:2px}.reading table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:18px 0;font-size:15px}.reading th,.reading td{border:1px solid var(--stroke);padding:8px 12px;text-align:left;vertical-align:top}.reading th{background:var(--panel-strong);font-weight:600}.reading hr{border:0;height:1px;background:var(--stroke);margin:24px 0}</style>
