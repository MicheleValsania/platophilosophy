<style>
    .kicker{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;border:1px solid rgba(216,193,138,.18);background:rgba(216,193,138,.08);color:var(--text);font-size:13px;}
    .kdot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(216,193,138,.12);display:inline-block;}
    .panel{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:16px;}
    .meta-line{margin-top:10px;font-size:13px;color:var(--muted-soft);}
    .reading{max-width:78ch;line-height:1.7;color:var(--text);}
    .reading p{margin:12px 0;}
    .reading h2{margin-top:24px;color:var(--text-strong);}
    .reading strong{color:var(--text-strong);}
    .reading em{color:var(--muted);}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start;margin-top:18px;}
    .box-title{margin:0 0 10px;font-family:var(--font-serif);font-size:16px;color:var(--text-strong);}
    .box-text{margin:0;color:var(--muted);font-size:14px;line-height:1.6;}
    .list{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:14px;line-height:1.6;}
    .hr{height:1px;background:var(--stroke);margin:20px 0;}
    .nav-row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:18px;}
    .mini{font-size:12px;color:var(--muted-soft);line-height:1.5;}
    @media (max-width:900px){.two-col{grid-template-columns:1fr;}}
  </style>
