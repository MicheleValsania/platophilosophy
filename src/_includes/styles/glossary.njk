<style>
    .kicker{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;border:1px solid rgba(216,193,138,.18);background:rgba(216,193,138,.08);color:var(--text);font-size:13px;}
    .kdot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(216,193,138,.12);display:inline-block;}
    .panel{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:20px;}
    .alpha-nav{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0;padding:16px;background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-md);}
    .alpha-link{padding:6px 10px;color:var(--muted);font-size:14px;font-weight:600;border-radius:6px;cursor:pointer;transition:all 0.2s;}
    .alpha-link:hover{background:rgba(216,193,138,.12);color:var(--accent);}
    .letter-section{margin:32px 0;}
    .letter-heading{font-size:32px;font-weight:700;color:var(--accent);font-family:var(--font-serif);margin-bottom:20px;padding-bottom:8px;border-bottom:2px solid var(--stroke);}
    .term{margin:20px 0;padding:16px;background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius-md);}
    .term-title{font-size:18px;font-weight:700;color:var(--text);margin-bottom:6px;}
    .term-greek{color:var(--accent);font-family:var(--font-serif);font-size:16px;font-weight:600;}
    .term-translit{color:var(--muted);font-style:italic;font-size:14px;margin-left:8px;}
    .term-def{color:var(--muted);font-size:15px;line-height:1.6;margin-top:8px;}
    .term-ref{color:var(--muted-soft);font-size:13px;margin-top:8px;font-style:italic;}
    .hr{height:1px;background:var(--stroke);margin:24px 0;}
    .nav-row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:32px;}
    @media (max-width:900px){.nav-row{flex-direction:column;}.alpha-nav{gap:6px;}}
  </style>
