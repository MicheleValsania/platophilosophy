{% include "styles/philosophy-pages.njk" %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
  <style>
    #map{width:100%;height:600px;border-radius:8px;border:1px solid var(--stroke);margin:24px 0}
    .leaflet-popup-content-wrapper{background:var(--panel);color:var(--text);border:1px solid var(--stroke)}
    .leaflet-popup-tip{background:var(--panel);border:1px solid var(--stroke)}
    .location-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin:8px 0 24px}
    .location-card{padding:12px;background:var(--panel);border:1px solid var(--stroke);border-radius:6px}
    .location-card h4{margin:0 0 8px 0;color:var(--accent);font-size:16px}
    .location-card p{margin:0 0 8px;font-size:14px;color:var(--muted);line-height:1.5}
    .location-card a{font-size:13px;font-weight:600;color:var(--accent)}
    @media (max-width:640px){ #map{height:420px} }
  </style>
