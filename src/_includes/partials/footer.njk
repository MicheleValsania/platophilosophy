<footer>
  <div class="wrap">
    <p style="color:var(--text);">{{ "footer.statement" | t(lang) }}</p>
    <p style="margin-top:8px;color:var(--muted-soft);">{{ "footer.tagline" | t(lang) }}</p>
    <p style="margin-top:12px;font-size:12px;color:var(--muted-soft);">
      <a href="{{ '/privacy.html' | localeUrl(lang) }}">{{ "ui.privacy" | t(lang) }}</a> · <a href="{{ '/terms.html' | localeUrl(lang) }}">{{ "ui.terms" | t(lang) }}</a> · <a href="mailto:{{ site.email }}">{{ "ui.contact" | t(lang) }}</a>
    </p>
    <p style="margin-top:14px;font-size:12px;color:var(--muted-soft);">© <span id="y"></span> {{ site.domain }} · {{ "footer.licensePrefix" | t(lang) }} <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license" style="color:inherit;">CC BY-NC-SA 4.0</a></p>
  </div>
</footer>
