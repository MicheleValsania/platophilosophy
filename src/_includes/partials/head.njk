{%- set alts = translationKey | alternates -%}
{%- set selfUrl = canonical or page.url -%}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ (pageTitle or title) | safe }}</title>
{%- if description %}
  <meta name="description" content="{{ description | safe }}" />
{%- endif %}
{%- if robots %}
  <meta name="robots" content="{{ robots | safe }}" />
{%- endif %}
{%- if canonical %}
  <link rel="canonical" href="{{ site.url }}{{ canonical }}" />
{%- endif %}
{%- if site.hreflang and alts.length > 1 %}
{%- for a in alts %}
  <link rel="alternate" hreflang="{{ a.lang }}" href="{{ site.url }}{{ a.url }}" />
{%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alts[0].url }}" />
{%- endif %}
{%- if ogAuto %}
  <meta property="og:title" content="{{ title | safe }}" />
  <meta property="og:description" content="{{ description | safe }}" />
  <meta property="og:type" content="{{ ogType or 'article' }}" />
  <meta property="og:url" content="{{ site.url }}{{ selfUrl }}" />
  <meta property="og:site_name" content="Plato Philosophy" />
  <meta property="og:locale" content="{{ site.ogLocale[lang] }}" />
{%- for a in alts %}{% if a.lang != lang %}
  <meta property="og:locale:alternate" content="{{ site.ogLocale[a.lang] }}" />
{%- endif %}{% endfor %}
  <meta property="og:image" content="https://platophilosophy.com/assets/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Plato Philosophy — Discover Plato, step by step" />
  <meta name="twitter:card" content="summary_large_image" />
{%- else %}
{%- for tag in og %}
  <meta property="{{ tag[0] }}" content="{{ tag[1] | safe }}" />
{%- endfor %}
{%- for tag in twitter %}
  <meta name="{{ tag[0] }}" content="{{ tag[1] | safe }}" />
{%- endfor %}
{%- endif %}
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/images/favicon/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/assets/images/favicon/site.webmanifest">
  <link rel="stylesheet" href="/assets/css/main.css">
